<mxfile host="app.diagrams.net">
  <diagram name="DeepUNet">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- Input -->
        <mxCell id="input" value="1500×1500×1" style="shape=rectangle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="120" height="40" as="geometry"/>
        </mxCell>

        <!-- Encoder Block 1 -->
        <mxCell id="enc1" value="ConvBlock 1 → 32" style="shape=rectangle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="200" width="120" height="40" as="geometry"/>
        </mxCell>
        
        <!-- Encoder Block 2 -->
        <mxCell id="enc2" value="ConvBlock 32 → 64" style="shape=rectangle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="200" width="120" height="40" as="geometry"/>
        </mxCell>

        <!-- Encoder Block 3 -->
        <mxCell id="enc3" value="ConvBlock 64 → 128" style="shape=rectangle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="520" y="200" width="120" height="40" as="geometry"/>
        </mxCell>

        <!-- Bottleneck -->
        <mxCell id="bottleneck" value="Bottleneck 128 → 256" style="shape=rectangle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="680" y="200" width="140" height="40" as="geometry"/>
        </mxCell>

        <!-- Decoder Block 3 -->
        <mxCell id="dec3" value="Up + Conv 256 → 128" style="shape=rectangle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="840" y="200" width="140" height="40" as="geometry"/>
        </mxCell>

        <!-- Decoder Block 2 -->
        <mxCell id="dec2" value="Up + Conv 128 → 64" style="shape=rectangle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1000" y="200" width="140" height="40" as="geometry"/>
        </mxCell>

        <!-- Decoder Block 1 -->
        <mxCell id="dec1" value="Up + Conv 64 → 32" style="shape=rectangle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1160" y="200" width="140" height="40" as="geometry"/>
        </mxCell>

        <!-- Output -->
        <mxCell id="output" value="Conv 1x1 → 1" style="shape=rectangle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1320" y="200" width="120" height="40" as="geometry"/>
        </mxCell>

        <!-- Final Upsample -->
        <mxCell id="upsample" value="Upsample → 1500×1500" style="shape=rectangle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1460" y="200" width="140" height="40" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="input" target="enc1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="enc1" target="enc2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="enc2" target="enc3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="enc3" target="bottleneck">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="bottleneck" target="dec3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="dec3" target="dec2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="dec2" target="dec1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="dec1" target="output">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="output" target="upsample">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

